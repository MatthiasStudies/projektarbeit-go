package main

type A interface {
	m1()
}

type B interface {
	m1()
	m2()
}

type Sa struct{}

type Sb struct{}

func (x Sa) m1() {}

func (x Sb) m1() {}
func (x Sb) m2() {}

// Some generic function.
func f[T A](x T, y B) {
	y.m2()
	x.m1()
}

func main() {
	// If uncommented, yields a type error.
	f[Sb](Sa{}, Sb{})
	// cannot use Sa{} (value of struct type Sa) as Sb value in argument to f[Sb]
}
